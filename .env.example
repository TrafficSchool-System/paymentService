# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/paymentServiceDb
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Eureka
EUREKA_URL=http://localhost:8761/eureka/

# Server
SERVER_PORT=8085

# Service API Key for internal service-to-service communication
# VIKTIGT: Måste vara samma i alla services!
SERVICE_API_KEY=your_service_api_key_change_in_production

# Swish Configuration - TEST ENVIRONMENT
# VIKTIGT: Byt till produktionsvärden innan lansering!
SWISH_BASE_URL=https://mss.cpc.getswish.net
SWISH_MERCHANT_NUMBER=1234679304
SWISH_CALLBACK_URL=https://your-domain.com/api/webhooks/swish
SWISH_KEYSTORE_PATH=classpath:certificates/Swish_Merchant_TestCertificate_1234679304.p12
SWISH_KEYSTORE_PASSWORD=your_swish_keystore_password
SWISH_CA_CERT_PATH=classpath:certificates/Swish_TLS_RootCA.pem

# Swish Production (Uncomment and configure for production)
# SWISH_BASE_URL=https://cpc.getswish.net
# SWISH_KEYSTORE_PATH=classpath:certificates/SwishMerchantProductionCertificate.p12
# SWISH_KEYSTORE_PASSWORD=your_production_password_here
